# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEYS=key1,key2,key3

# ── LinkedIn cookie auth ─────────────────────────────────────────────────────
LINKEDIN_LI_AT=your-li_at-cookie
LINKEDIN_JSESSIONID=your-jsessionid-cookie

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=your-sheet-id
GOOGLE_CREDENTIALS_PATH=credentials/google-sheets.json

# ── Proxies (optional) ───────────────────────────────────────────────────────
# PROXIES=http://user:pass@host:port,http://user:pass@host2:port2

# ── Gmail (email status tracking) ────────────────────────────────────────────
# From a Desktop-app OAuth client in Google Cloud Console. Run
# `python gmail_service.py` once to authorize and print these values.
GMAIL_CLIENT_ID=your-oauth-client-id
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# ── Discord notifications ────────────────────────────────────────────────────
# Channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_NOTIFICATIONS_URL=https://discord.com/api/webhooks/...
# Optional: prefix pings so they reach your phone, e.g. <@your-user-id>
# DISCORD_MENTION=<@000000000000000000>

# ── Email checker tuning (optional) ──────────────────────────────────────────
# EMAIL_LOOKBACK_HOURS=48
# EMAIL_MIN_CONFIDENCE=0.6
# EMAIL_DRY_RUN=1
# TIMEZONE=America/Los_Angeles
